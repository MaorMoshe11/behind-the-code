# Copy this file to a new file named .env and fill in your own values.
# The .env file is private: never share it and never put it in git.

# Your secret key from https://platform.claude.com (not needed in mock mode)
ANTHROPIC_API_KEY=

# Which Claude model to chat with
CHAT_MODEL=claude-opus-5-5

# 1 = fake answers, free, no key needed. 0 = real answers from the API.
CHAT_MOCK=1

# The name printed before each reply
AGENT_NAME=agent

# How many recent turns are sent to the model, at most (one turn = your message + the reply)
CHAT_MAX_TURNS=10

# The budget of one model call, in estimated tokens (system, tools, summary, turns, question).
# CHAT_CONTEXT_TOKENS=16000
# 1 = when a turn would not fit, summarise the older turns (compaction). 0 = leave them out.
# CHAT_COMPACT=1

# With a notes service, the model may call the notes tools: the agent loop. At most this
# many model calls for one message; then the loop stops and says so.
# CHAT_MAX_STEPS=5

# 1 = the model may also add and delete notes (add_note, delete_note). 0 (the default) =
# it may only read them (list_notes). Every tool call is logged, with "writes": true or false.
# CHAT_WRITE_TOOLS=0

# 1 = a router may hand a big review (notes + earlier conversations) to a team of agents:
# an orchestrator and two reading specialists. 0 (the default) = no router, no team.
# CHAT_TEAM=0
# The router's and the specialists' model (unset: CHAT_MODEL).
# CHAT_WORKER_MODEL=claude-opus-5-5
# One team run, all agents together: model calls and tokens, at most.
# CHAT_TEAM_MAX_STEPS=20
# CHAT_TEAM_MAX_TOKENS=60000
# 1 = independent specialists work at the same time. 0 = one after the other.
# CHAT_TEAM_PARALLEL=1
# Mock mode only: seconds every mock call waits, to measure time offline.
# CHAT_MOCK_DELAY=0

# How much detail goes into agent.log: DEBUG, INFO, WARNING or ERROR
CHAT_LOG_LEVEL=INFO

# Where the SDK sends requests. Leave it unset for the real API.
# To watch the requests with scripts/echo_server.py, use:
# ANTHROPIC_BASE_URL=http://127.0.0.1:8000

# The key that clients must send to this agent's own API, in the X-API-Key header.
# Make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_API_KEY=

# More clients, each with its own key. The server keeps only hashes: name:sha256 entries,
# comma separated. Make one with: uv run python scripts/new_key.py <name>
# AGENT_API_KEYS=

# How many /chat messages one client may send per minute (more get 429)
# CHAT_RATE_LIMIT=30

# The token Prometheus sends to read /metrics. Unset: /metrics answers 404.
# Make one like AGENT_API_KEY. compose.yaml hands it to Prometheus as a secret.
METRICS_TOKEN=

# Where scripts/ask.py finds the API (the default is shown)
# AGENT_URL=http://127.0.0.1:8000

# Where conversations are stored. The default is a SQLite file in the project folder.
# DATABASE_URL=sqlite:///agent.db
# The Postgres of docker compose, from this computer (compose.yaml sets its own for the API):
# DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent

# Where the agent runs: local (the default here), staging or prod (set by deploy/*.env).
# APP_ENV=local
# A secret can also come from a file: <NAME>_FILE=<path>, for example
# AGENT_API_KEY_FILE=/run/secrets/agent_api_key. The database password can be kept out of
# DATABASE_URL in DATABASE_PASSWORD (or DATABASE_PASSWORD_FILE).

# The notes service (notes-service/). Leave NOTES_URL unset to run without notes.
# NOTES_URL=http://127.0.0.1:8100
# The key the notes service expects from the agent; the notes service reads the same name.
# NOTES_API_KEY=

# Kafka (chapter 12). Set it to publish events (message.created, conversation.deleted);
# unset, nothing is published and nothing needs Kafka. compose.yaml sets kafka:9092 for the
# api and the worker. The worker also reads WORKER_GROUP (default usage-worker) and
# USAGE_DATABASE_URL (default sqlite:///usage.db).
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
