# Copy this file to a new file named .env and fill in your own values.
# The .env file is private: never share it and never put it in git.

# Your secret key from https://platform.claude.com (not needed in mock mode)
ANTHROPIC_API_KEY=

# Which Claude model to chat with
CHAT_MODEL=claude-opus-5-5

# 1 = fake answers, free, no key needed. 0 = real answers from the API.
CHAT_MOCK=1

# The name printed before each reply
AGENT_NAME=agent

# How many recent turns are sent to the model (one turn = your message + the reply)
CHAT_MAX_TURNS=10

# How much detail goes into agent.log: DEBUG, INFO, WARNING or ERROR
CHAT_LOG_LEVEL=INFO

# Where the SDK sends requests. Leave it unset for the real API.
# To watch the requests with scripts/echo_server.py, use:
# ANTHROPIC_BASE_URL=http://127.0.0.1:8000

# The key that clients must send to this agent's own API, in the X-API-Key header.
# Make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_API_KEY=

# Where scripts/ask.py finds the API (the default is shown)
# AGENT_URL=http://127.0.0.1:8000

# Where conversations are stored. The default is a SQLite file in the project folder.
# DATABASE_URL=sqlite:///agent.db
# The Postgres of docker compose, from this computer (compose.yaml sets its own for the API):
# DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent
