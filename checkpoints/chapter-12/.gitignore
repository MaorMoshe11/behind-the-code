# Secrets and private settings: never commit these
.env

# The virtual environment is rebuilt from uv.lock with `uv sync`
.venv/

# Files Python generates while running
__pycache__/
*.pyc

# Log files the agent writes while it runs
*.log

# Editor settings that belong to one person
.vscode/
.idea/

# Local databases (SQLite files) and their temporary journal files
*.db
*.db-journal

# The type checker's cache (mypy writes it on every run)
.mypy_cache/

# The secrets of the deployed environments (scripts/make_secrets.py)
deploy/secrets/

# Reports written by pipelines/usage_report.py
reports/
